{
  "name": "acp-plus-session",
  "version": "0.1.0-candidate.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit && node scripts/check-consumers.ts",
    "test:codecs": "vitest run",
    "probe": "node scripts/probes/run.ts",
    "test:qualification": "node --test tests/codex-guard.test.ts tests/process-ownership.test.ts tests/verification-hook.test.ts",
    "verify": "node scripts/verify.ts",
    "test:core": "node --test tests/core/*.test.ts",
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.109.0",
    "@openai/codex": "0.112.0",
    "ajv": "8.20.0",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.328",
    "@openai/codex-linux-arm64": "npm:@openai/codex@0.112.0-linux-arm64"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "acpx": "0.22.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "acp-plus-session": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "pnpm-lock.yaml",
    "native/",
    "dependency-lock.yaml"
  ]
}
